{
  "info": {
    "name": "Scholar Sync — GraphQL API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección completa para probar la API GraphQL de Scholar Sync. Importar en Postman, configurar la variable BASE_URL y ejecutar en orden."
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:9000/graphql" },
    { "key": "TOKEN", "value": "" },
    { "key": "ADMIN_TOKEN", "value": "" },
    { "key": "COURSE_ID", "value": "" },
    { "key": "ENROLLMENT_ID", "value": "" },
    { "key": "USER_ID", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "01 - Signup (student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.signup) {",
                  "  pm.collectionVariables.set('TOKEN', res.data.signup.token);",
                  "  pm.collectionVariables.set('USER_ID', res.data.signup.user.id);",
                  "  pm.test('Signup OK - token recibido', () => pm.expect(res.data.signup.token).to.be.a('string'));",
                  "  pm.test('Rol es student', () => pm.expect(res.data.signup.user.roles).to.include('student'));",
                  "} else {",
                  "  pm.test('Signup fallido', () => pm.expect(res.errors).to.be.undefined);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation Signup($input: SignUpInput!) { signup(signUpInput: $input) { token user { id email roles isActive } } }\",\n  \"variables\": {\n    \"input\": {\n      \"email\": \"student@scholar.com\",\n      \"password\": \"Password123\",\n      \"firstName\": \"Carlos\",\n      \"lastName\": \"López\"\n    }\n  }\n}"
            },
            "url": "{{BASE_URL}}"
          }
        },
        {
          "name": "02 - Signup (admin — luego promover en BD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
