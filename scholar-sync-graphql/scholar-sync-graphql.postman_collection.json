                  "pm.test('Curso desactivado', () => pm.expect(res.data.removeCourse.isActive).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation RemoveCourse($id: ID!) { removeCourse(id: $id) { id isActive } }\",\n  \"variables\": { \"id\": \"{{COURSE_ID}}\" }\n}"
            },
            "url": "{{BASE_URL}}"
          }
        }
      ]
    }
  ]
