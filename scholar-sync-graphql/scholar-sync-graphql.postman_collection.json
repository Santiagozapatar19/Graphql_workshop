                  "  pm.test('Admin signup OK', () => pm.expect(res.data.signup.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation Signup($input: SignUpInput!) { signup(signUpInput: $input) { token user { id email } } }\",\n  \"variables\": {\n    \"input\": {\n      \"email\": \"admin@scholar.com\",\n      \"password\": \"Admin123\",\n      \"firstName\": \"Super\",\n      \"lastName\": \"Admin\"\n    }\n  }\n}"
            },
            "url": "{{BASE_URL}}"
