            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation Login($input: LoginInput!) { login(loginInput: $input) { token user { id email roles } } }\",\n  \"variables\": {\n    \"input\": {\n      \"email\": \"student@scholar.com\",\n      \"password\": \"Password123\"\n    }\n  }\n}"
